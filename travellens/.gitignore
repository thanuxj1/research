# TravelLens LK -- what does and does not belong in the repository.
#
# Rule applied: commit anything a person needs to REPRODUCE the work, and
# nothing the pipeline can regenerate. A 481 MB model and 195 MB of
# intermediate CSVs are outputs, not inputs; the code that produces them is
# the thing worth keeping under version control.

# ---------------------------------------------------------------- models
# models/travellens-polarity/ is 481 MB and is regenerated by
# scripts/11_finetune.py. It is also the model we do NOT deploy -- it inverts
# 55% of safety complaints (see aggregate.build_tree).
models/

# ---------------------------------------------------------- large outputs
# Regenerated by scripts/10_refresh.py in about 15 seconds from cache.
data/processed/segments*.csv
data/processed/reviews_clean.csv
data/processed/polarity_cache*.csv
data/processed/hierarchy.json
data/processed/weak_training_set.csv
travellens.db

# Kept: the small, hard-to-regenerate results.
!data/processed/scorecards.csv
!data/processed/media.csv
!data/processed/destination_coordinates.csv
!data/processed/destination_links.json

# ------------------------------------------------------------ source data
# The two review corpora are third-party scrapes. Redistributing them is not
# this project's right to grant -- see release/SOURCES.md for provenance and
# release/DATASHEET.md for what IS released.
data/raw/*.csv
!data/raw/sri_lanka_districts.geojson
!data/raw/SOURCES.md
!data/raw/GEOJSON_SOURCE.txt

# Raw collector dumps: reproducible by re-running the collectors.
data/incoming/
data/snapshots/

# ---------------------------------------------------------------- release
# enriched_labels.csv is 20 MB and rebuilt by scripts/24_release.py.
release/enriched_labels.csv

# ---------------------------------------------------------------- python
__pycache__/
*.pyc
.pytest_cache/

# One-off migration scripts used to build up dashboard/template.html
# incrementally. They are NOT idempotent -- re-running one would apply its
# edit a second time and corrupt the template. The template itself is the
# committed artifact; these were scaffolding.
scripts/_patch_*.py
