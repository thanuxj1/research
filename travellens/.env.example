# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example is the committed template so the required variables are
# documented without ever shipping a real credential.

# --------------------------------------------------------------------------
# User-submission storage (scripts/41_serve_api.py, src/travellens/api.py)
# --------------------------------------------------------------------------
# Unset: reviews submitted through the portal go to a local SQLite file
# (user_submissions.db) -- the default, and all that local development needs.
#
# Set to a Postgres connection string: submissions go there instead. Needed
# once this API runs somewhere with an ephemeral filesystem (most hosted
# platforms), where a local SQLite file is wiped on every redeploy. See
# src/travellens/submissions_db.py for the full reasoning.
#
# Get this string from your Neon project dashboard -> Connection Details.
# It already includes ?sslmode=require -- keep that suffix.
SUBMISSIONS_DATABASE_URL=postgresql://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require

# --------------------------------------------------------------------------
# The research pipeline (scripts/01-38) never reads this file. Its data
# comes from data/raw and data/processed, built once and checked in --
# nothing about a portal deploy changes that.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# API request handling (src/travellens/api.py)
# --------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Unset
# means "*", which is fine on a laptop and wrong on a deploy: /analyse is an
# unauthenticated POST that writes to the submissions corpus, so any page on
# the internet can post to it while the wildcard stands.
# ALLOWED_ORIGINS=https://your-portal.example,https://www.your-portal.example

# Submissions accepted per IP per minute on POST /analyse. Default 30.
# In-process and per-worker, so it is a brake rather than a guarantee;
# anything stronger belongs at the reverse proxy.
# ANALYSE_RATE_LIMIT=30
