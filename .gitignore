# Environment Variables & Secrets
.env
.env.*
# ...but example files carry no secrets and are the documented way to tell
# somebody what to set. backend/.env.example and travellens/.env.example
# were already tracked only because they predate the rule above; this makes
# that deliberate rather than accidental.
!.env.example
backend/.env
backend/.env.*

# Python & Virtual Environments
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# Heavy Binaries & ML Models (>10MB)
*.joblib
*.pkl
*.h5
*.onnx
*.pth

# Heavy Raw Datasets & Databases (>100MB GitHub Limit)
*.csv
*.db
*.sqlite
*.sqlite3
archive/
archive (1)/
archive (2)/
archive (3)/
archive (4)/
archive (5)/
archive (6)/
backend/*.db
backend/training/dataset/*.csv

# Node.js & Build Outputs
node_modules/
dist/
build/
.npm/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temp & Artifact Storage
.tempmediaStorage/
scratch/
*.log
*.zip
extracted_zip/

# Session cookies & browser credentials (never commit)
cookies.txt
**/cookies.txt
*.cookies
