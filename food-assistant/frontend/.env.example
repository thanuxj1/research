# Base URL of the food assistant's FastAPI backend.
# Copy this file to `.env` (or `.env.local`) before running `npm run dev`.
#
# 8001, not the 8000 this application's own docs use, because SafeTravel LK's
# API already holds 8000 in this repository. Without this file the client falls
# back to http://localhost:8000 (see src/api/client.js) and talks to the wrong
# service -- which fails in a confusing way rather than an obvious one, since
# that port answers.
VITE_API_URL=http://localhost:8001
